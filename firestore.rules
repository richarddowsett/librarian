rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication, ownership, and validation
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isExistingOwner() {
      return isSignedIn() && (
        (resource.data.keys().hasAll(['ownerId']) && request.auth.uid == resource.data.ownerId) ||
        (resource.data.keys().hasAll(['userId']) && request.auth.uid == resource.data.userId)
      );
    }

    function isNewOwner() {
      return isSignedIn() && (
        (request.resource.data.keys().hasAll(['ownerId']) && request.auth.uid == request.resource.data.ownerId) ||
        (request.resource.data.keys().hasAll(['userId']) && request.auth.uid == request.resource.data.userId)
      );
    }

    // 1. Users Collection - User Profile Data
    match /users/{userId} {
      allow read: if isOwner(userId) || isExistingOwner();
      allow create: if isOwner(userId) || isNewOwner();
      allow update: if (isOwner(userId) || isExistingOwner()) && (isOwner(userId) || isNewOwner());
      allow delete: if isOwner(userId) || isExistingOwner();
    }

    // 2. Books Collection - Individual User Library
    match /books/{bookId} {
      allow read: if isExistingOwner();
      allow create: if isNewOwner() &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() > 0 &&
                       request.resource.data.title.size() <= 300 &&
                       request.resource.data.readStatus in ['unread', 'reading', 'read'];
      allow update: if isExistingOwner() && isNewOwner() &&
                       request.resource.data.title is string &&
                       request.resource.data.readStatus in ['unread', 'reading', 'read'];
      allow delete: if isExistingOwner();
    }

    // 3. Series Collection - Series Metadata & Tracking
    match /series/{seriesId} {
      allow read: if isExistingOwner();
      allow create: if isNewOwner() &&
                       request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() <= 300;
      allow update: if isExistingOwner() && isNewOwner() &&
                       request.resource.data.name is string;
      allow delete: if isExistingOwner();
    }

    // 4. User Series Status Collection - User Progress on Series
    match /user_series_status/{statusId} {
      allow read: if isExistingOwner();
      allow create: if isNewOwner() &&
                       request.resource.data.isCompleted is bool;
      allow update: if isExistingOwner() && isNewOwner() &&
                       request.resource.data.isCompleted is bool;
      allow delete: if isExistingOwner();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
